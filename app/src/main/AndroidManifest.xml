<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ab Android 13 muss man um Benachrichtigungen bitten. Die App fragt im
         Onboarding danach und bleibt ohne sie voll benutzbar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Die App holt ihre Updates selbst von der Releaseseite auf GitHub; es
         gibt keinen Store, der das täte. Installiert wird trotzdem nicht
         still: Das System fragt jedes Mal nach. Siehe Aktualisierung.kt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/netz_sicherheit"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="MIMIK"
        android:supportsRtl="false"
        android:theme="@style/Theme.Mimik">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reicht dem Installer des Systems die geladene APK-Datei. Ohne das
             sieht er nur eine file:-Adresse, die seit Android 7 verboten ist. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fassungen"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dateipfade" />
        </provider>
    </application>
</manifest>
